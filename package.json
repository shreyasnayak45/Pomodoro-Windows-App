{
  "name": "antigravity-pomodoro-test",
  "private": true,
  "description": "A beautiful desktop Pomodoro app",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "vite",
    "dev:desktop": "cross-env VITE_DEV_SERVER_URL=http://localhost:5174 concurrently -k \"vite --port 5174\" \"wait-on http://localhost:5174 && electron .\"",
    "build:web": "vite build",
    "build:desktop": "vite build && npx electron-packager . Pomodoro --platform=win32 --arch=x64 --icon=build/icon.ico --out=dist-electron --asar --overwrite",
    "build:installer": "vite build && npx electron-builder --win --x64 -p never",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.antigravity.pomodoro",
    "productName": "Pomodoro",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "shreyasnayak45",
        "repo": "Pomodoro-Windows-App"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "installerIcon": "build/installer-icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "jimp": "^1.6.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-winstaller": "^5.4.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gif-encoder-2": "^1.0.5",
    "globals": "^17.6.0",
    "png-to-ico": "^3.0.1",
    "puppeteer": "^25.0.4",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
